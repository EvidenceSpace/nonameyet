{
  "name": "casefind",
  "version": "0.1.0",
  "private": true,
  "description": "Current CaseFind prototype and approved EvidenceSpace target foundation.",
  "type": "module",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "sync:pdfjs": "node scripts/sync-pdfjs.mjs",
    "preview": "npm run sync:pdfjs && node scripts/serve-static.mjs",
    "serve": "npm run sync:pdfjs && tsx server/runtime.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:browser": "playwright test",
    "benchmark:extraction": "tsx scripts/build-extraction-benchmark.ts",
    "benchmark:compare": "tsx scripts/compare-extraction-benchmarks.ts",
    "check:dependencies": "node scripts/check-dependency-policy.mjs",
    "check:workflow-actions": "node scripts/check-workflow-action-pins.mjs",
    "check:docs": "node scripts/check-canonical-docs.mjs",
    "check": "npm run check:dependencies && npm run check:workflow-actions && npm run check:docs && npm run typecheck && npm test"
  },
  "dependencies": { "pdfjs-dist": "4.10.38" },
  "devDependencies": {
    "playwright": "1.62.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
